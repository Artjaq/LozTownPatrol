---
layout: base.njk
titre: "Événements"
page_active: evenements
permalink: /events/
---

<section class="page-head">
  <div class="container">
    <h1>Événements</h1>
    <p>Toutes nos sessions &amp; soirées</p>
  </div>
</section>

<section class="events-archive">
  <div class="container">

    <div class="events-section">
      <div class="sec-label">
        <h2>À venir</h2>
        <span class="sec-label-line"></span>
        <span class="sec-label-count">{{ collections.evenements_a_venir.length }}</span>
      </div>

      {% if collections.evenements_a_venir.length %}
      <div class="poster-row">
        {% for evenement in collections.evenements_a_venir %}
        <article class="pcard">
          <div class="pcard-top">
            {% if evenement.data.image_principale %}
            <img src="{{ evenement.data.image_principale }}" alt="{{ evenement.data.titre }}" loading="lazy">
            {% else %}
            <div class="event-media-placeholder"></div>
            {% endif %}
            <span class="pcard-badge">{{ evenement.data.date | dateJourMois }}</span>
            {% if evenement.data.prix %}
            <span class="pcard-prix">{{ evenement.data.prix }}</span>
            {% endif %}
          </div>
          <div class="pcard-body">
            <h3 class="pcard-title">{{ evenement.data.titre }}</h3>
            <p class="pcard-meta">
              {{ evenement.data.lieu }}{% if evenement.data.heure %} · {{ evenement.data.heure }}{% endif %}
            </p>
            {% if evenement.data.genres and evenement.data.genres.length %}
            <div class="pcard-chips">
              {% for genre in evenement.data.genres %}
              <span class="chip">{{ genre }}</span>
              {% endfor %}
            </div>
            {% endif %}
            <a class="pcard-link" href="/events/{{ evenement.page.fileSlug }}/" aria-label="Voir {{ evenement.data.titre }}">Détails →</a>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="muted">Aucun événement à venir pour le moment.</p>
      {% endif %}
    </div>

    <div class="events-section">
      <div class="sec-label">
        <h2>Passés</h2>
        <span class="sec-label-line"></span>
        <span class="sec-label-count">archive</span>
      </div>

      {% if collections.evenements_passes.length %}
      <div class="poster-row poster-row--past">
        {% for evenement in collections.evenements_passes %}
        <article class="pcard">
          <div class="pcard-top">
            {% if evenement.data.image_principale %}
            <img src="{{ evenement.data.image_principale }}" alt="{{ evenement.data.titre }}" loading="lazy">
            {% else %}
            <div class="event-media-placeholder"></div>
            {% endif %}
            <span class="pcard-badge">{{ evenement.data.date | dateJourMois }}</span>
            {% if evenement.data.prix %}
            <span class="pcard-prix">{{ evenement.data.prix }}</span>
            {% endif %}
          </div>
          <div class="pcard-body">
            <h3 class="pcard-title">{{ evenement.data.titre }}</h3>
            <p class="pcard-meta">
              {{ evenement.data.lieu }}{% if evenement.data.heure %} · {{ evenement.data.heure }}{% endif %}
            </p>
            {% if evenement.data.genres and evenement.data.genres.length %}
            <div class="pcard-chips">
              {% for genre in evenement.data.genres %}
              <span class="chip">{{ genre }}</span>
              {% endfor %}
            </div>
            {% endif %}
            <a class="pcard-link" href="/events/{{ evenement.page.fileSlug }}/" aria-label="Voir {{ evenement.data.titre }}">Revoir →</a>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="muted">Aucun événement passé pour le moment.</p>
      {% endif %}
    </div>

  </div>
</section>
